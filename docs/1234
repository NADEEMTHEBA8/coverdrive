## File 2: generate_diagram.py (Python Diagrams as Code)

```python
from diagrams import Cluster, Diagram, Edge
from diagrams.aws.compute import Fargate
from diagrams.aws.storage import SimpleStorageServiceS3
from diagrams.aws.analytics import (
    EMR,
    Athena,
    ManagedWorkflowsForApacheAirflow,
    GlueDataCatalog,
)
from diagrams.aws.database import ElastiCache
from diagrams.aws.security import SecretsManager, KeyManagementService
from diagrams.aws.management import Cloudwatch
from diagrams.aws.security import IAM

# Graph Configuration
graph_attr = {
    "fontsize": "24",
    "fontname": "Inter",
    "bgcolor": "#FFFFFF",
    "pad": "0.5",
    "splines": "ortho",
}

with Diagram(
    "Enterprise Medallion Data Platform Architecture",
    filename="architecture_diagram",
    outformat="png",
    direction="LR",
    graph_attr=graph_attr,
):
    # Cross-Cutting Operational Plane
    with Cluster("CROSS-CUTTING OPERATIONAL PLANE", graph_attr={"bgcolor": "#F1F5F9"}):
        air_flow = ManagedWorkflowsForApacheAirflow("AWS MWAA Airflow")
        security = SecretsManager("Secrets Manager & KMS")
        observability = Cloudwatch("CloudWatch & X-Ray")

    # Main Private VPC
    with Cluster("AWS CLOUD REGION / PRIVATE VPC BOUNDARY", graph_attr={"bgcolor": "#F8FAFC"}):

        # Zone 1: Ingestion
        with Cluster("ZONE 1: INGESTION & INGRESS"):
            ecs_ingest = Fargate("AWS ECS Fargate\n(Python Tasks)")

        # Zone 2: Bronze
        with Cluster("ZONE 2: BRONZE LAKE & QUALITY"):
            s3_bronze = SimpleStorageServiceS3("Amazon S3\nBronze Lake")
            s3_dlq = SimpleStorageServiceS3("Amazon S3 DLQ\n(Bad Data)")

        # Zone 3: Silver
        with Cluster("ZONE 3: SILVER COMPUTE & PROCESSING"):
            emr_spark = EMR("EMR Serverless Spark")
            s3_silver = SimpleStorageServiceS3("Amazon S3\nSilver Lake")

        # Zone 4: Gold & Governance
        with Cluster("ZONE 4: GOLD LAKE & GOVERNANCE"):
            glue_catalog = GlueDataCatalog("AWS Glue Catalog")
            s3_gold = SimpleStorageServiceS3("Amazon S3\nGold Lake")

        # Zone 5: Serving
        with Cluster("ZONE 5: SERVING & ANALYTICS"):
            athena = Athena("Amazon Athena SQL")
            redis = ElastiCache("ElastiCache Redis")
            fastapi = Fargate("FastAPI on ECS")

        # Data Pipelines Connections
        ecs_ingest >> Edge(label="1. Raw Parquet", color="#0284C7") >> s3_bronze
        s3_bronze >> Edge(label="Schema Violation", color="#DC2626", style="dashed") >> s3_dlq
        s3_bronze >> Edge(label="2. Validated", color="#0284C7") >> emr_spark
        emr_spark >> Edge(color="#0284C7") >> s3_silver
        s3_silver >> Edge(label="3. Cleaned", color="#0284C7") >> s3_gold

        # Governance Links
        glue_catalog - Edge(color="#059669", style="dotted") - s3_silver
        glue_catalog - Edge(color="#059669", style="dotted") - s3_gold

        # Serving Links
        s3_gold << Edge(color="#0284C7") << athena
        s3_gold << Edge(color="#0284C7") << fastapi
        fastapi >> Edge(color="#0284C7") >> redis

        # Control Plane Orchestration Lines
        air_flow >> Edge(color="#7C3AED", style="dotted") >> ecs_ingest
        air_flow >> Edge(color="#7C3AED", style="dotted") >> emr_spark
```
